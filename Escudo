<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Escudo Legal - Módulo Asistencia</title>
    <style>
        /* Los colores exactos de tu diseño original */
        :root {
            --azul-profundo: #0a0f1f;
            --cian-escudo: #00bfd8;
            --gris-tarjeta: #1a2438;
            --texto-blanco: #f2f2f2;
            --azul-boton: #263852;
        }

        body {
            background-color: var(--azul-profundo);
            color: var(--texto-blanco);
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        /* Barra de pestañas (Tabs) */
        .tabs-container {
            display: flex;
            background-color: var(--azul-profundo);
            border-bottom: 2px solid var(--gris-tarjeta);
            overflow-x: auto;
            sticky: top;
        }

        .tab-button {
            flex: 1;
            background: none;
            border: none;
            color: var(--texto-blanco);
            padding: 15px 10px;
            font-size: 13px;
            font-weight: bold;
            cursor: pointer;
            text-align: center;
            white-space: nowrap;
            border-bottom: 3px solid transparent;
        }

        .tab-button.active {
            color: var(--cian-escudo);
            border-bottom: 3px solid var(--cian-escudo);
        }

        /* Contenedor de las tarjetas de leyes */
        .content-container {
            padding: 12px;
            display: none;
        }

        .content-container.active {
            display: block;
        }

        /* Tarjeta idéntica a tus capturas */
        .tarjeta-articulo {
            background-color: var(--gris-tarjeta);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 100px;
        }

        .texto-ley {
            width: 82%;
        }

        .titulo-ley {
            color: var(--cian-escudo);
            font-size: 15px;
            font-weight: bold;
            margin: 0 0 5px 0;
        }

        .cuerpo-ley {
            font-size: 13px;
            margin: 0;
            color: var(--texto-blanco);
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Botón de altoparlante circular/cuadrado activo */
        .btn-audio {
            width: 15%;
            height: 50px;
            background-color: var(--azul-boton);
            border: none;
            border-radius: 8px;
            color: var(--cian-escudo);
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-audio:active {
            background-color: var(--cian-escudo);
            color: var(--azul-profundo);
        }
    </style>
</head>
<body>

    <div class="tabs-container">
        <button class="tab-button active" onclick="cambiarPestaña('penal')">PENAL</button>
        <button class="tab-button" onclick="cambiarPestaña('civil')">CIVIL Y COM.</button>
        <button class="tab-button" onclick="cambiarPestaña('familia')">FAMILIA Y MEN.</button>
        <button class="tab-button" onclick="cambiarPestaña('consumidor')">CONSUMIDOR</button>
        <button class="tab-button" onclick="cambiarPestaña('laboral')">LABORAL</button>
    </div>

    <div id="penal" class="content-container active">
        <div class="tarjeta-articulo">
            <div class="texto-ley">
                <p class="titulo-ley">Código Penal - Artículo 1</p>
                <p class="cuerpo-ley">Este código se aplicará por delitos cometidos o cuyos efectos deban producirse en el territorio de la Nación Argentina.</p>
            </div>
            <button class="btn-audio" onclick="hablar('Código Penal Artículo 1. Este código se aplicará por delitos cometidos o cuyos efectos deban producirse en el territorio de la Nación Argentina.')">🔊</button>
        </div>
    </div>

    <div id="civil" class="content-container">
        <div class="tarjeta-articulo">
            <div class="texto-ley">
                <p class="titulo-ley">Código Civil y Com. - Artículo 1</p>
                <p class="cuerpo-ley">Fuentes y aplicación. Los casos que este Código rige deben ser resueltos según las leyes que resulten aplicables.</p>
            </div>
            <button class="btn-audio" onclick="hablar('Código Civil y Comercial Artículo 1. Fuentes y aplicación. Los casos que este Código rige deben ser resueltos según las leyes.')">🔊</button>
        </div>
    </div>

    <div id="familia" class="content-container">
        <div class="tarjeta-articulo">
            <div class="texto-ley">
                <p class="titulo-ley">Familia y Menores - Módulo Base</p>
                <p class="cuerpo-ley">Contenido legal cargado dentro de la sección FAMILIA Y MENORES. Tocá el parlante derecho para validación por audio.</p>
            </div>
            <button class="btn-audio" onclick="hablar('Módulo de familia y menores activo.')">🔊</button>
        </div>
    </div>

    <div id="consumidor" class="content-container">
        <div class="tarjeta-articulo">
            <div class="texto-ley">
                <p class="titulo-ley">Consumidor - Ley 24.240</p>
                <p class="cuerpo-ley">Defensa del Consumidor. La presente ley tiene por objeto la defensa del consumidor o usuario.</p>
            </div>
            <button class="btn-audio" onclick="hablar('Ley 24.240. Defensa del Consumidor. La presente ley tiene por objeto la defensa del consumidor o usuario.')">🔊</button>
        </div>
    </div>

    <div id="laboral" class="content-container">
        <div class="tarjeta-articulo">
            <div class="texto-ley">
                <p class="titulo-ley">Laboral - Ley de Contrato de Trabajo</p>
                <p class="cuerpo-ley">Artículo 1. Fuentes de regulación. El contrato de trabajo y la relación de trabajo se rigen por esta ley.</p>
            </div>
            <button class="btn-audio" onclick="hablar('Ley de Contrato de Trabajo Artículo 1. Fuentes de regulación. El contrato de trabajo y la relación de trabajo se rigen por esta ley.')">🔊</button>
        </div>
    </div>

    <script>
        // Lógica para cambiar de pestaña en la web
        function cambiarPestaña(idCategoria) {
            // Desactivar todos los botones y contenidos
            document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.content-container').forEach(cont => cont.classList.remove('active'));
            
            // Activar la pestaña correcta
            event.currentTarget.classList.add('active');
            document.getElementById(idCategoria).classList.add('active');
        }

        // Lógica de Altoparlante nativa para celulares (Sustituye a plyer.tts)
        function hablar(texto) {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel(); // Detiene audios anteriores si los hay
                var utterance = new SpeechSynthesisUtterance(texto);
                utterance.lang = 'es-AR'; // Español de Argentina
                window.speechSynthesis.speak(utterance);
            } else {
                alert("Tu navegador no soporta salida de audio de voz.");
            }
        }
    </script>
</body>
</html>
