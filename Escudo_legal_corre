# ==========================================
# 2. MOTOR DE DETECCIÓN GEOGRÁFICA (POLÍGONOS)
# ==========================================
def obtener_modulo_por_coordenadas(lat, lon):
    """
    Analiza la latitud y longitud. 
    Apunta fino si es CABA, si es el cinturón de Buenos Aires (PBA), 
    y si se va de rango cae en el escudo Federal genérico.
    """
    # Caja aproximada del mapa de CABA (Delimitada por Gral Paz y el Río)
    if (-34.705 <= lat <= -34.525) and (-58.531 <= lon <= -58.335):
        return "CABA"
    
    # Caja extendida de la Provincia de Buenos Aires
    elif (-41.000 <= lat <= -33.000) and (-63.000 <= lon <= -56.500):
        return "PBA"
    
    # Si viaja a otra provincia o falla el GPS, se activa el Escudo Federal Nacional
    return "FEDERAL_ARG"

# ==========================================
# 3. ACCIONES DEL BOTÓN DE PÁNICO / ESCUDO
# ==========================================
class EscudoLegalAsistente:
    def __init__(self):
        self.lat_actual = 0.0
        self.lon_actual = 0.0
        self.jurisdiccion_activa = "FEDERAL_ARG"

    def actualizar_ubicacion(self, lat, lon):
        self.lat_actual = lat
        self.lon_actual = lon
        self.jurisdiccion_activa = obtener_modulo_por_coordenadas(lat, lon)

    def disparar_alerta_rapida(self, tipo_control):
        """
        Devuelve el botiquín legal de emergencia para escupir en pantalla 
        o mandar por texto según la situación.
        tipo_control puede ser: 'identificacion', 'retencion_vehiculo', 'filmacion'
        """
        datos = DB_LEGAL[self.jurisdiccion_activa]
        
        informe = []
        informe.append(f"🚨 ALERTA LEGAL DISPARADA 🚨")
        informe.append(f"📍 Zona: {datos['jurisdiccion']}")
        informe.append(f"🛡️ Amparo: {datos['constitucion']}")
        informe.append(f"📝 Ley de Control: {datos['ley_policial'] if tipo_control != 'retencion_vehiculo' else datos['ley_transito']}")
        informe.append(f"\n🔥 LEY DEFENSA EN VIVO:")
        informe.append(datos['articulos_clave'].get(tipo_control, "Procedimiento no mapeado. Exigir orden judicial escrita."))
        informe.append(f"\n📞 CONTACTOS DE DENUNCIA INMEDIATA:")
        for tel in datos['telefonos_emergencia']:
            informe.append(f" - {tel}")
            
        return "\n".join(informe)

